# Every environment variable TheMoak ERP reads. No values here: on Liara they are set in the app's panel
# (Settings → Environment variables, or `liara env set`), on Vercel in Project → Settings → Environment Variables,
# locally in .env (never committed). docs/deploy-liara.md says where each value comes from.

# ---- Database -------------------------------------------------------------------------------------------
# Liara: the database's PRIVATE-network URI (postgresql://root:<password>@<db-id>:5432/<db name>). Prisma and the
# start-up schema sync (scripts/db-deploy.mjs) read it. Do not add connection_limit=1: the scheduled backup holds
# one connection for its lock and needs a second.
DATABASE_URL=

# ---- Where it runs ---------------------------------------------------------------------------------------
# production on the live ERP outside Vercel (Liara). It turns on: the stock push to the website after every
# stock change, the refusal to keep receipts/photos on the server's own disk when FTP is not set, and, at server
# start, the UTC clock and the database schema sync (src/lib/live-server.ts). It also stops `npm run build` from
# touching the database (Liara's builder cannot reach it). Leave it unset on Vercel, in development and in tests.
APP_ENV=
# UTC. The ERP's date code expects a UTC server, as on Vercel; Liara's containers default to Asia/Tehran.
# (The server also forces UTC at start on APP_ENV=production.)
TZ=
# Optional: the commit being deployed, shown in each backup file's header. Baked in at build when set then, or
# from git when the build has it. On Vercel, VERCEL_GIT_COMMIT_SHA is used instead.
APP_COMMIT_SHA=
# Optional: how long a starting server waits for another one's schema sync before giving up (ms, default 900000).
DB_DEPLOY_LOCK_WAIT_MS=

# ---- Sign-in (Auth.js / NextAuth v5) -----------------------------------------------------------------------
# At least 32 random characters: openssl rand -base64 32. Keep the SAME value as the old ERP, or everyone is
# signed out at the switch. NEXTAUTH_SECRET is read only when AUTH_SECRET is empty (older name).
AUTH_SECRET=
NEXTAUTH_SECRET=
# The public address, https://erp.themoak.com. Auth.js uses it, and password-reset links are built from it.
AUTH_URL=
# true. The code already trusts the proxy's host header (trustHost in src/auth.ts); set it anyway behind Liara's
# and Cloudflare's proxies.
AUTH_TRUST_HOST=

# ---- Scheduled jobs ----------------------------------------------------------------------------------------
# The daily backup check and the website photo sync (liara.json "cron", vercel.json "crons") and the stock-push
# flush send `Authorization: Bearer <CRON_SECRET>`. Without it every scheduled call is refused (401).
# openssl rand -base64 32
CRON_SECRET=

# ---- The ERP's own API (/api/erp) --------------------------------------------------------------------------
# The owner's full key: the Claude MCP tools (mcp-server/) use it.
ERP_API_SECRET=
# The website's key (themoak.com calls /api/erp with it): only the website's four actions.
ERP_SITE_API_SECRET=
# Not read by the server: the ERP's base URL for mcp-server/ and scripts/install-claude.sh on your own machine,
# https://erp.themoak.com.
ERP_API_URL=

# ---- Outgoing mail (password reset, src/lib/mail.ts) -------------------------------------------------------
SMTP_HOST=
# 465 (TLS from the start, the default) or 587 (STARTTLS)
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
# e.g. TheMoak ERP <no-reply@themoak.com>
SMTP_FROM=

# ---- Set by the host, never by hand ------------------------------------------------------------------------
# NODE_ENV (Next.js), VERCEL, VERCEL_ENV, VERCEL_GIT_COMMIT_SHA (Vercel only), NEXT_RUNTIME, NEXT_PHASE (Next.js).

# ---- Build only, optional ----------------------------------------------------------------------------------
# A mirror for Prisma's engine downloads (prisma generate / npm install), if binaries.prisma.sh is unreachable from
# the builder. Not needed with liara.json's "build": {"location": "germany"}.
PRISMA_ENGINES_MIRROR=
# 1 stops Next.js's anonymous telemetry calls from the build and the server.
NEXT_TELEMETRY_DISABLED=
