{
  "openapi": "3.1.0",
  "info": {
    "title": "TheMoak ERP API",
    "description": "Connect to TheMoak ERP system to query financial data, accounts, orders, and record transactions.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://erp.themoak.com",
      "description": "Production server"
    }
  ],
  "security": [
    { "bearerAuth": [] }
  ],
  "paths": {
    "/api/erp": {
      "get": {
        "operationId": "erpQuery",
        "summary": "Query ERP data",
        "description": "Fetch financial summaries, accounts, transactions, orders, settlements, loans, search, stock across warehouses, per-product sales, suppliers or purchase orders.",
        "parameters": [
          {
            "name": "action",
            "in": "query",
            "required": true,
            "description": "The data to fetch: summary | accounts | transactions | orders | settlements | loans | search | inventory | productSales | suppliers | purchaseOrders",
            "schema": {
              "type": "string",
              "enum": ["summary", "accounts", "transactions", "orders", "settlements", "loans", "search", "inventory", "productSales", "suppliers", "purchaseOrders"]
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Search query (required when action=search)",
            "schema": { "type": "string" }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Max results (for transactions/orders, default 50)",
            "schema": { "type": "integer", "default": 50 }
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "description": "Filter transactions by type: INCOME | EXPENSE | TRANSFER",
            "schema": { "type": "string", "enum": ["INCOME", "EXPENSE", "TRANSFER"] }
          },
          {
            "name": "filter",
            "in": "query",
            "required": false,
            "description": "Stock filter when action=inventory",
            "schema": { "type": "string", "enum": ["all", "low", "zero", "negative"], "default": "all" }
          },
          {
            "name": "low",
            "in": "query",
            "required": false,
            "description": "Low-stock threshold for action=inventory&filter=low, counted on `available`",
            "schema": { "type": "integer", "default": 5 }
          },
          {
            "name": "sku",
            "in": "query",
            "required": false,
            "description": "Only SKUs containing this text (action=inventory)",
            "schema": { "type": "string" }
          },
          {
            "name": "includeArchived",
            "in": "query",
            "required": false,
            "description": "Include archived warehouses (action=inventory)",
            "schema": { "type": "boolean", "default": false }
          },
          {
            "name": "days",
            "in": "query",
            "required": false,
            "description": "Sales window in days when action=productSales (max 730)",
            "schema": { "type": "integer", "default": 90 }
          },
          {
            "name": "supplier",
            "in": "query",
            "required": false,
            "description": "action=purchaseOrders: a supplier's id, or part of its name",
            "schema": { "type": "string" }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "action=purchaseOrders: only orders in this status",
            "schema": { "type": "string", "enum": ["DRAFT", "PENDING_PAYMENT", "PARTIALLY_PAID", "PAID", "IN_PRODUCTION", "ARRIVED", "PARTIALLY_RECEIVED", "RECEIVED", "CANCELLED"] }
          },
          {
            "name": "tag",
            "in": "query",
            "required": false,
            "description": "action=purchaseOrders: only orders carrying this tag, e.g. PI:2026-031",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    { "$ref": "#/components/schemas/SummaryResponse" },
                    { "$ref": "#/components/schemas/AccountsResponse" },
                    { "$ref": "#/components/schemas/TransactionsResponse" },
                    { "$ref": "#/components/schemas/SearchResponse" }
                  ]
                }
              }
            }
          },
          "401": { "description": "Unauthorized — check your API key" }
        }
      },
      "post": {
        "operationId": "erpWrite",
        "summary": "Write to ERP (record transactions, suppliers, products, purchase orders)",
        "description": "Record a deposit, expense/payment, or internal transfer between accounts. Send a fresh requestId with each entry and the same one when retrying it: an entry is booked once per requestId. Also: a supplier, a product, or a purchase order recorded in the supplier's currency with no Toman figure (its Toman value is the rate paid, at payment). A tag starting with PI: books one order per PI.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  { "$ref": "#/components/schemas/DepositRequest" },
                  { "$ref": "#/components/schemas/ExpenseRequest" },
                  { "$ref": "#/components/schemas/TransferRequest" },
                  { "$ref": "#/components/schemas/CreateSupplierRequest" },
                  { "$ref": "#/components/schemas/CreateProductRequest" },
                  { "$ref": "#/components/schemas/CreatePurchaseOrderRequest" }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Transaction recorded, or already recorded under this requestId (duplicate: true, nothing new written)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/WriteResponse" }
              }
            }
          },
          "400": { "description": "Bad request — missing fields, no exchange rate for the currency, or the same source and destination" },
          "401": { "description": "Unauthorized" },
          "422": { "description": "Refused — amount not above 0, unknown currency, a transfer currency that is not the accounts', a date that is not Gregorian (a Jalali 1405-06-30, or any year before 1900), or a requestId that is not 8-64 letters, digits, - or _" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Set ERP_API_SECRET in Vercel env and use it as Bearer token here."
      }
    },
    "schemas": {
      "SummaryResponse": {
        "type": "object",
        "properties": {
          "totalBalanceToman": { "type": "number" },
          "accounts": { "type": "integer" },
          "last30Days": {
            "type": "object",
            "properties": {
              "income": { "type": "number" },
              "expense": { "type": "number" },
              "profit": { "type": "number" }
            }
          },
          "pendingSettlements": { "type": "integer" }
        }
      },
      "AccountsResponse": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": { "type": "string" },
            "name": { "type": "string" },
            "type": { "type": "string" },
            "currency": { "type": "string" },
            "balance": { "type": "number" },
            "cardNumber": { "type": "string", "nullable": true },
            "sheba": { "type": "string", "nullable": true }
          }
        }
      },
      "TransactionsResponse": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": { "type": "string" },
            "date": { "type": "string", "format": "date-time" },
            "type": { "type": "string" },
            "amount": { "type": "number" },
            "currency": { "type": "string" },
            "amountInToman": { "type": "number" },
            "description": { "type": "string" },
            "category": { "type": "string" },
            "account": { "type": "string" },
            "payee": { "type": "string", "nullable": true },
            "tags": { "type": "array", "items": { "type": "string" } }
          }
        }
      },
      "SearchResponse": {
        "type": "object",
        "properties": {
          "customers": { "type": "array", "items": { "type": "object" } },
          "products": { "type": "array", "items": { "type": "object" } },
          "transactions": { "type": "array", "items": { "type": "object" } },
          "orders": { "type": "array", "items": { "type": "object" } }
        }
      },
      "WriteResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "message": { "type": "string" },
          "duplicate": { "type": "boolean", "description": "true when this requestId was already booked; the rows are the earlier ones" },
          "transactions": {
            "type": "array",
            "description": "The booked rows; a transfer has two, the outgoing leg first",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "type": { "type": "string" },
                "accountId": { "type": "string" },
                "amount": { "type": "number", "description": "In the account's own currency" },
                "currency": { "type": "string" },
                "amountInToman": { "type": "number" },
                "date": { "type": "string", "format": "date-time" },
                "balance": { "type": "number", "description": "The account's balance after this write (for a duplicate: its balance now)" }
              }
            }
          }
        }
      },
      "DepositRequest": {
        "type": "object",
        "required": ["action", "accountId", "amount", "description"],
        "properties": {
          "action": { "type": "string", "enum": ["deposit"] },
          "accountId": { "type": "string", "description": "Target account ID" },
          "amount": { "type": "number", "exclusiveMinimum": 0, "description": "Amount in the given currency" },
          "currency": { "type": "string", "enum": ["TOMAN", "USD", "EUR", "CNY"], "description": "Currency of amount; defaults to the account's own currency. Pass it explicitly." },
          "description": { "type": "string", "description": "What is this deposit for?" },
          "category": { "type": "string" },
          "date": { "type": "string", "format": "date", "description": "Gregorian YYYY-MM-DD, defaults to today. A Jalali date (1405-06-30) is refused." },
          "requestId": { "type": "string", "description": "8-64 letters, digits, - or _. The same id is booked once." }
        }
      },
      "ExpenseRequest": {
        "type": "object",
        "required": ["action", "accountId", "amount", "description"],
        "properties": {
          "action": { "type": "string", "enum": ["expense"] },
          "accountId": { "type": "string", "description": "Source account ID" },
          "amount": { "type": "number", "exclusiveMinimum": 0 },
          "currency": { "type": "string", "enum": ["TOMAN", "USD", "EUR", "CNY"], "description": "Currency of amount; defaults to the account's own currency. Pass it explicitly." },
          "description": { "type": "string" },
          "category": { "type": "string" },
          "payee": { "type": "string", "description": "Who received the payment" },
          "date": { "type": "string", "format": "date", "description": "Gregorian YYYY-MM-DD, defaults to today. A Jalali date is refused." },
          "requestId": { "type": "string", "description": "8-64 letters, digits, - or _. The same id is booked once." }
        }
      },
      "TransferRequest": {
        "type": "object",
        "required": ["action", "fromAccountId", "toAccountId", "amount"],
        "properties": {
          "action": { "type": "string", "enum": ["transfer"] },
          "fromAccountId": { "type": "string" },
          "toAccountId": { "type": "string" },
          "amount": { "type": "number", "exclusiveMinimum": 0 },
          "currency": { "type": "string", "enum": ["TOMAN", "USD", "EUR", "CNY"], "description": "Optional; refused unless it is both accounts' currency" },
          "description": { "type": "string" },
          "date": { "type": "string", "format": "date", "description": "Gregorian YYYY-MM-DD, defaults to today. A Jalali date is refused." },
          "requestId": { "type": "string", "description": "8-64 letters, digits, - or _. The same id is booked once." }
        }
      },
      "CreateSupplierRequest": {
        "type": "object",
        "required": ["action", "name"],
        "properties": {
          "action": { "type": "string", "enum": ["createSupplier"] },
          "name": { "type": "string", "description": "Refused when a supplier already has it (case and outer spaces aside)" },
          "phone": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "address": { "type": "string" }
        }
      },
      "CreateProductRequest": {
        "type": "object",
        "required": ["action", "sku", "name", "sellPrice"],
        "properties": {
          "action": { "type": "string", "enum": ["createProduct"] },
          "sku": { "type": "string", "description": "Unique, case aside" },
          "name": { "type": "string" },
          "sellPrice": { "type": "number", "minimum": 0, "description": "Toman" },
          "costPrice": { "type": "number", "minimum": 0, "default": 0, "description": "Toman" },
          "productType": { "type": "string", "enum": ["SALEABLE", "FIXED_ASSET", "CONSUMABLE", "OTHER"], "default": "SALEABLE" }
        }
      },
      "CreatePurchaseOrderRequest": {
        "type": "object",
        "required": ["action", "supplier", "items"],
        "properties": {
          "action": { "type": "string", "enum": ["createPurchaseOrder"] },
          "supplier": { "type": "string", "description": "The supplier's name or id" },
          "currency": { "type": "string", "enum": ["TOMAN", "USD", "EUR", "CNY"], "description": "The order's one currency (the PI's); lines and costs without their own take it. Two currencies in one order are refused." },
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["sku", "quantity", "unitCost"],
              "properties": {
                "sku": { "type": "string" },
                "quantity": { "type": "integer", "minimum": 1 },
                "unitCost": { "type": "number", "minimum": 0, "description": "In the order's currency; 0 for a free line. The same SKU may come twice." },
                "currency": { "type": "string", "enum": ["TOMAN", "USD", "EUR", "CNY"] }
              }
            }
          },
          "additionalCosts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["title", "amount"],
              "properties": {
                "title": { "type": "string" },
                "amount": { "type": "number", "minimum": 0 },
                "currency": { "type": "string", "enum": ["TOMAN", "USD", "EUR", "CNY"] }
              }
            }
          },
          "tags": { "type": "array", "items": { "type": "string" }, "description": "A tag starting with PI: names the supplier's proforma invoice; an order not cancelled already carrying it refuses this one." },
          "status": { "type": "string", "enum": ["DRAFT", "PENDING_PAYMENT"], "default": "DRAFT" }
        }
      }
    }
  }
}
