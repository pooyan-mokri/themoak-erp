{
  "app": "themoak-erp",
  "platform": "next",
  "port": 3000,
  "next": {
    "nodeVersion": "22"
  },
  "build": {
    "location": "germany"
  },
  "healthCheck": {
    "command": [
      "CMD",
      "curl",
      "--fail",
      "--silent",
      "--show-error",
      "--output",
      "/dev/null",
      "http://localhost:3000/api/health"
    ],
    "interval": 30000,
    "timeout": 20000,
    "retries": 3,
    "startPeriod": 300000
  },
  "cron": [
    "30 1 * * * curl --fail --silent --show-error --max-time 300 -H \"Authorization: Bearer $CRON_SECRET\" http://localhost:3000/api/site/catalogue-sync",
    "0 0 * * * curl --fail --silent --show-error --max-time 900 -H \"Authorization: Bearer $CRON_SECRET\" http://localhost:3000/api/cron/backup",
    "*/2 * * * * curl --fail --silent --show-error --max-time 60 -H \"Authorization: Bearer $CRON_SECRET\" http://localhost:3000/api/site/hook-flush"
  ]
}
